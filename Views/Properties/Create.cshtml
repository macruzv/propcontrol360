@model propcontrol360.Models.Property
@{
    ViewData["Title"] = "Registrar Inmueble / Terreno";
}

<div class="row justify-content-center">
    <div class="col-lg-10">
        <div class="card shadow-sm border-0">
            <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
                <h3 class="card-title fw-bold text-white mb-0" id="formHeaderTitle">
                    <i class="ti ti-plus me-2"></i>Registrar Inmueble, Terreno o Lote
                </h3>
                <span class="badge bg-white text-primary fw-bold" id="categoryBadge">Modo Estándar</span>
            </div>
            <div class="card-body p-4">
                <form asp-action="Create" method="post" id="propertyForm">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <!-- Category Selector Ribbon -->
                    <div class="p-3 bg-light rounded-3 mb-4 border">
                        <div class="row align-items-center g-3">
                            <div class="col-md-5">
                                <label class="form-label fw-bold mb-1"><i class="ti ti-category text-primary me-1"></i> Categoría del Inmueble *</label>
                                <select asp-for="Category" id="categorySelect" asp-items="Html.GetEnumSelectList<propcontrol360.Models.PropertyCategory>()" class="form-select form-select-lg fw-bold text-primary border-primary"></select>
                            </div>
                            <div class="col-md-7">
                                <div class="small text-muted" id="categoryHint">
                                    <i class="ti ti-info-circle text-primary me-1"></i> Selecciona <strong>Lote</strong> o <strong>Terreno</strong> para habilitar cotizador financiero, cálculo por m², frente, fondo y sincronización con el Master Plan.
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="row g-3">
                        <div class="col-md-8">
                            <label class="form-label fw-bold" id="labelTitle">Título de la Propiedad / Lote *</label>
                            <input asp-for="Title" id="titleInput" class="form-control" placeholder="Ej: Residencial Las Margaritas - MZA-8 Lote 06" />
                            <span asp-validation-for="Title" class="text-danger"></span>
                        </div>

                        <div class="col-md-4">
                            <label class="form-label fw-bold">Estado *</label>
                            <select asp-for="Status" asp-items="Html.GetEnumSelectList<propcontrol360.Models.PropertyStatus>()" class="form-select"></select>
                        </div>

                        <div class="col-md-4">
                            <label class="form-label fw-bold">Proyecto / Residencial</label>
                            <input asp-for="ProjectName" id="projectNameInput" class="form-control" placeholder="Ej: Residencial Las Margaritas" />
                        </div>

                        <div class="col-md-4">
                            <label class="form-label fw-bold" id="labelBlock">Manzana / Bloque</label>
                            <input asp-for="BlockCode" id="blockCodeInput" class="form-control" placeholder="Ej: MZA-08" />
                        </div>

                        <div class="col-md-4">
                            <label class="form-label fw-bold" id="labelLot">Número de Lote / Unidad</label>
                            <input asp-for="LotNumber" id="lotNumberInput" class="form-control" placeholder="Ej: Lote 6" />
                        </div>

                        <!-- SECCIÓN DINÁMICA: ESPECÍFICA PARA LOTES & TERRENOS -->
                        <div class="col-12" id="lotSpecialSection">
                            <div class="card border-success border-opacity-50 shadow-none bg-success bg-opacity-10 rounded-3">
                                <div class="card-header bg-success text-white py-2">
                                    <h4 class="card-title mb-0 fs-4 fw-bold">
                                        <i class="ti ti-ruler-measure me-2"></i> Dimensiones & Cotizador de Terrenos / Lotes
                                    </h4>
                                </div>
                                <div class="card-body p-3">
                                    <div class="row g-3">
                                        <div class="col-md-4">
                                            <label class="form-label fw-bold text-dark">Superficie Total (m²) *</label>
                                            <div class="input-group">
                                                <input asp-for="AreaSqM" id="areaSqMInput" class="form-control fw-bold" type="number" step="0.01" placeholder="1133.10" />
                                                <span class="input-group-text">m²</span>
                                            </div>
                                        </div>

                                        <div class="col-md-4">
                                            <label class="form-label fw-bold text-dark">Metros de Frente (m)</label>
                                            <div class="input-group">
                                                <input asp-for="FrontMeters" id="frontMetersInput" class="form-control" type="number" step="0.01" placeholder="28.33" />
                                                <span class="input-group-text">m</span>
                                            </div>
                                        </div>

                                        <div class="col-md-4">
                                            <label class="form-label fw-bold text-dark">Metros de Fondo (m)</label>
                                            <div class="input-group">
                                                <input asp-for="DepthMeters" id="depthMetersInput" class="form-control" type="number" step="0.01" placeholder="40.00" />
                                                <span class="input-group-text">m</span>
                                            </div>
                                        </div>

                                        <div class="col-md-4">
                                            <label class="form-label fw-bold text-dark">Precio por m² (USD)</label>
                                            <div class="input-group">
                                                <span class="input-group-text">$</span>
                                                <input asp-for="PricePerSqM" id="pricePerSqMInput" class="form-control" type="number" step="0.01" placeholder="250.00" />
                                                <span class="input-group-text">/m²</span>
                                            </div>
                                        </div>

                                        <div class="col-md-4">
                                            <label class="form-label fw-bold text-dark">Precio Total del Lote (USD) *</label>
                                            <div class="input-group">
                                                <span class="input-group-text text-success fw-bold">$</span>
                                                <input asp-for="Price" id="priceInput" class="form-control fw-bold text-success fs-3" type="number" step="0.01" placeholder="283275" />
                                            </div>
                                            <span asp-validation-for="Price" class="text-danger"></span>
                                        </div>

                                        <div class="col-md-4">
                                            <label class="form-label fw-bold text-dark">% Enganche / Inicial Mínimo</label>
                                            <div class="input-group">
                                                <input asp-for="MinDownPaymentPercent" id="downPaymentPctInput" class="form-control" type="number" step="0.1" value="10.0" />
                                                <span class="input-group-text">%</span>
                                            </div>
                                        </div>

                                        <!-- Live Financing Calculation Preview Ribbon -->
                                        <div class="col-12">
                                            <div class="bg-white p-3 rounded-3 border border-success">
                                                <div class="row align-items-center text-center g-2">
                                                    <div class="col-sm-3 border-end">
                                                        <div class="text-muted small">Enganche Mínimo</div>
                                                        <div class="fw-bold text-success fs-3" id="calcEngancheMonto">$0.00</div>
                                                    </div>
                                                    <div class="col-sm-3 border-end">
                                                        <div class="text-muted small">Saldo a Financiar</div>
                                                        <div class="fw-bold text-dark fs-3" id="calcSaldoFinanciar">$0.00</div>
                                                    </div>
                                                    <div class="col-sm-6">
                                                        <div class="d-flex align-items-center justify-content-center gap-2">
                                                            <span class="small text-muted">Cuota estimada:</span>
                                                            <span class="fw-extrabold text-success fs-2" id="calcCuotaEstimada">$0.00/mes</span>
                                                            <span class="badge bg-success-lt" id="calcMesesBadge">72 meses</span>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- SECCIÓN DINÁMICA: RESIDENCIAL (Casas / Apartamentos) -->
                        <div class="col-md-6" id="residentialBedrooms">
                            <label class="form-label fw-bold">Habitaciones</label>
                            <input asp-for="Bedrooms" class="form-control" type="number" value="0" />
                        </div>

                        <div class="col-md-6" id="residentialBathrooms">
                            <label class="form-label fw-bold">Baños</label>
                            <input asp-for="Bathrooms" class="form-control" type="number" value="0" />
                        </div>

                        <!-- Non-lote Price and Area for Standard Properties -->
                        <div class="col-md-6" id="standardAreaSection">
                            <label class="form-label fw-bold">Área Construida (m²) *</label>
                            <input asp-for="AreaSqM" id="standardAreaInput" class="form-control" type="number" step="0.1" placeholder="120" />
                        </div>

                        <div class="col-md-6" id="standardPriceSection">
                            <label class="form-label fw-bold">Precio Total (USD) *</label>
                            <div class="input-group">
                                <span class="input-group-text">$</span>
                                <input asp-for="Price" id="standardPriceInput" class="form-control" type="number" step="0.01" placeholder="150000" />
                            </div>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label fw-bold">Vendedor / Asesor Asignado</label>
                            <select asp-for="AgentId" asp-items="ViewBag.AgentId" class="form-select">
                                <option value="">-- Sin Asignar --</option>
                            </select>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label fw-bold">Ciudad *</label>
                            <input asp-for="City" class="form-control" placeholder="Ej: Santo Domingo" />
                            <span asp-validation-for="City" class="text-danger"></span>
                        </div>

                        <div class="col-12">
                            <label class="form-label fw-bold">Dirección Completa *</label>
                            <input asp-for="Address" class="form-control" placeholder="Ej: Sendero Jícama / Sendero Hábano" />
                            <span asp-validation-for="Address" class="text-danger"></span>
                        </div>

                        <div class="col-12">
                            <label class="form-label fw-bold">URL de la Imagen Principal</label>
                            <div class="input-group">
                                <span class="input-group-text bg-white"><i class="ti ti-photo text-primary"></i></span>
                                <input asp-for="ImageUrl" id="propertyImageUrl" class="form-control" placeholder="https://images.unsplash.com/photo-..." />
                            </div>
                        </div>

                        <div class="col-12">
                            <label class="form-label fw-bold">Descripción Detallada</label>
                            <textarea asp-for="Description" class="form-control" rows="3" placeholder="Detalles de topografía, amenidades, deslinde, acceso a servicios..."></textarea>
                        </div>

                        <div class="col-12">
                            <div class="form-check form-switch">
                                <input asp-for="Featured" class="form-check-input" type="checkbox" id="featuredCheck" />
                                <label class="form-check-label fw-bold" for="featuredCheck">Destacar en la Landing Page Principal</label>
                            </div>
                        </div>
                    </div>

                    <div class="d-flex justify-content-end gap-2 mt-4">
                        <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
                        <button type="submit" class="btn btn-primary fw-bold" id="btnSubmitProperty">
                            <i class="ti ti-device-floppy me-1"></i> Guardar Propiedad
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const categorySelect = document.getElementById("categorySelect");
            const lotSection = document.getElementById("lotSpecialSection");
            const bedSection = document.getElementById("residentialBedrooms");
            const bathSection = document.getElementById("residentialBathrooms");
            const standardArea = document.getElementById("standardAreaSection");
            const standardPrice = document.getElementById("standardPriceSection");
            const categoryBadge = document.getElementById("categoryBadge");
            const formHeaderTitle = document.getElementById("formHeaderTitle");

            const areaSqMInput = document.getElementById("areaSqMInput");
            const pricePerSqMInput = document.getElementById("pricePerSqMInput");
            const priceInput = document.getElementById("priceInput");
            const downPaymentPctInput = document.getElementById("downPaymentPctInput");

            const standardAreaInput = document.getElementById("standardAreaInput");
            const standardPriceInput = document.getElementById("standardPriceInput");

            function updateCategoryUI() {
                // Values corresponding to PropertyCategory: 0: Terreno, 1: Lote, 2: Casa, 3: Apartamento, 4: BloqueCompleto
                const selectedText = categorySelect.options[categorySelect.selectedIndex].text.toLowerCase();
                const isLot = selectedText.includes("lote") || selectedText.includes("terreno");

                if (isLot) {
                    lotSection.style.display = "block";
                    bedSection.style.display = "none";
                    bathSection.style.display = "none";
                    standardArea.style.display = "none";
                    standardPrice.style.display = "none";
                    
                    categoryBadge.textContent = "Modo CRM Lote & Terreno";
                    categoryBadge.className = "badge bg-white text-success fw-bold";
                    formHeaderTitle.innerHTML = '<i class="ti ti-map-2 me-2 text-warning"></i>Registrar Nuevo Lote / Terreno';
                    document.getElementById("btnSubmitProperty").className = "btn btn-success fw-bold";
                } else {
                    lotSection.style.display = "none";
                    bedSection.style.display = "block";
                    bathSection.style.display = "block";
                    standardArea.style.display = "block";
                    standardPrice.style.display = "block";

                    categoryBadge.textContent = "Modo Inmueble Estándar";
                    categoryBadge.className = "badge bg-white text-primary fw-bold";
                    formHeaderTitle.innerHTML = '<i class="ti ti-building me-2 text-warning"></i>Registrar Inmueble Residencial / Comercial';
                    document.getElementById("btnSubmitProperty").className = "btn btn-primary fw-bold";
                }
                recalculateLotFinancing();
            }

            function recalculateLotFinancing() {
                const area = parseFloat(areaSqMInput.value) || 0;
                const priceSqM = parseFloat(pricePerSqMInput.value) || 0;
                let totalPrice = parseFloat(priceInput.value) || 0;

                // Sync standard inputs so model binding succeeds regardless
                if (area > 0) standardAreaInput.value = area;
                if (totalPrice > 0) standardPriceInput.value = totalPrice;

                const downPct = parseFloat(downPaymentPctInput.value) || 10.0;
                const downAmount = (totalPrice * downPct) / 100;
                const balance = totalPrice - downAmount;
                const monthly = balance > 0 ? balance / 72 : 0;

                document.getElementById("calcEngancheMonto").textContent = `$${downAmount.toLocaleString('en-US', {minimumFractionDigits: 2, maximumFractionDigits: 2})}`;
                document.getElementById("calcSaldoFinanciar").textContent = `$${balance.toLocaleString('en-US', {minimumFractionDigits: 2, maximumFractionDigits: 2})}`;
                document.getElementById("calcCuotaEstimada").textContent = `$${monthly.toLocaleString('en-US', {minimumFractionDigits: 2, maximumFractionDigits: 2})}/mes`;
            }

            // Auto-calculate total price when area or price/m2 changes
            areaSqMInput.addEventListener("input", function() {
                const area = parseFloat(areaSqMInput.value) || 0;
                const priceSqM = parseFloat(pricePerSqMInput.value) || 0;
                if (priceSqM > 0 && area > 0) {
                    priceInput.value = (area * priceSqM).toFixed(2);
                }
                recalculateLotFinancing();
            });

            pricePerSqMInput.addEventListener("input", function() {
                const area = parseFloat(areaSqMInput.value) || 0;
                const priceSqM = parseFloat(pricePerSqMInput.value) || 0;
                if (area > 0 && priceSqM > 0) {
                    priceInput.value = (area * priceSqM).toFixed(2);
                }
                recalculateLotFinancing();
            });

            priceInput.addEventListener("input", function() {
                const area = parseFloat(areaSqMInput.value) || 0;
                const totalPrice = parseFloat(priceInput.value) || 0;
                if (area > 0 && totalPrice > 0) {
                    pricePerSqMInput.value = (totalPrice / area).toFixed(2);
                }
                recalculateLotFinancing();
            });

            downPaymentPctInput.addEventListener("input", recalculateLotFinancing);

            categorySelect.addEventListener("change", updateCategoryUI);
            updateCategoryUI();
        });
    </script>
}
