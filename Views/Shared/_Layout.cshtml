<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - PropControl360 | Gestión & Proyectos Inmobiliarios</title>
    
    <!-- Tabler UI Core CSS -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@@tabler/core@1.0.0-beta20/dist/css/tabler.min.css">
    <!-- Tabler Webfont Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@@tabler/icons-webfont@2.44.0/tabler-icons.min.css">
    <!-- Google Fonts Inter -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <!-- SweetAlert2 CSS -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.min.css">
    
    <!-- Custom Styles -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <style>
        :root {
            --tblr-font-sans-serif: 'Inter', -apple-system, BlinkMacSystemFont, San Francisco, Segoe UI, Roboto, Helvetica Neue, sans-serif;
            --tblr-primary: #206bc4;
            --tblr-primary-rgb: 32, 107, 196;
        }
        body {
            font-family: var(--tblr-font-sans-serif);
            background-color: #f4f6fa;
        }
        .bg-gradient-primary {
            background: linear-gradient(135deg, #1e3c72 0%, #2a5298 100%) !important;
            color: #ffffff !important;
        }
        .text-white-80 {
            color: rgba(255, 255, 255, 0.85) !important;
        }
        .transition-all {
            transition: all 0.25s ease-in-out;
        }
        .hover-shadow:hover {
            transform: translateY(-4px);
            box-shadow: 0 1rem 3rem rgba(31, 45, 61, 0.125) !important;
        }
    </style>
</head>
<body class="layout-boxed">
    <div class="page">
        <!-- Top Navbar with Tabler Aesthetics -->
        <header class="navbar navbar-expand-md navbar-dark navbar-overlap d-print-none bg-primary text-white">
            <div class="container-xl">
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbar-menu">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <h1 class="navbar-brand navbar-brand-autodark d-none-navbar-horizontal pe-0 pe-md-3 me-3">
                    <a asp-controller="Home" asp-action="Index" class="text-white d-flex align-items-center text-decoration-none">
                        <i class="ti ti-building-community me-2 fs-1 text-warning"></i>
                        <span class="fw-bold tracking-tight">Control Propiedades<span class="text-warning">360</span></span>
                    </a>
                </h1>
                <div class="navbar-nav flex-row order-md-last ms-auto me-2">
                    <div class="nav-item">
                        <a asp-controller="Home" asp-action="Dashboard" class="btn btn-outline-light btn-pill d-none d-sm-inline-block">
                            <i class="ti ti-dashboard me-1"></i> Panel 360
                        </a>
                    </div>
                </div>
            </div>
        </header>

        <!-- Navigation Bar -->
        <header class="navbar-expand-md">
            <div class="collapse navbar-collapse" id="navbar-menu">
                <div class="navbar navbar-light">
                    <div class="container-xl">
                        <ul class="navbar-nav">
                            <li class="nav-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "Home" && ViewContext.RouteData.Values["action"]?.ToString() == "Index" ? "active" : "")">
                                <a class="nav-link" asp-controller="Home" asp-action="Index">
                                    <span class="nav-link-icon d-md-none d-lg-inline-block"><i class="ti ti-world text-primary"></i></span>
                                    <span class="nav-link-title">Landing Pública</span>
                                </a>
                            </li>
                            <li class="nav-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "Home" && ViewContext.RouteData.Values["action"]?.ToString() == "Dashboard" ? "active" : "")">
                                <a class="nav-link" asp-controller="Home" asp-action="Dashboard">
                                    <span class="nav-link-icon d-md-none d-lg-inline-block"><i class="ti ti-layout-dashboard text-info"></i></span>
                                    <span class="nav-link-title">Dashboard 360</span>
                                </a>
                            </li>
                            <li class="nav-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "Properties" && ViewContext.RouteData.Values["action"]?.ToString() == "Index" ? "active" : "")">
                                <a class="nav-link" asp-controller="Properties" asp-action="Index">
                                    <span class="nav-link-icon d-md-none d-lg-inline-block"><i class="ti ti-building text-primary"></i></span>
                                    <span class="nav-link-title">Inventario General</span>
                                </a>
                            </li>
                            <li class="nav-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "Projects" ? "active" : "")">
                                <a class="nav-link" asp-controller="Projects" asp-action="Index">
                                    <span class="nav-link-icon d-md-none d-lg-inline-block"><i class="ti ti-building-community text-azure"></i></span>
                                    <span class="nav-link-title">Proyectos & Desarrollos</span>
                                </a>
                            </li>
                            <li class="nav-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "Properties" && ViewContext.RouteData.Values["action"]?.ToString() == "MasterPlan" ? "active" : "")">
                                <a class="nav-link" asp-controller="Properties" asp-action="MasterPlan">
                                    <span class="nav-link-icon d-md-none d-lg-inline-block"><i class="ti ti-map-2 text-success"></i></span>
                                    <span class="nav-link-title">Master Plan Lotes</span>
                                </a>
                            </li>
                            <li class="nav-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "Clients" ? "active" : "")">
                                <a class="nav-link" asp-controller="Clients" asp-action="Index">
                                    <span class="nav-link-icon d-md-none d-lg-inline-block"><i class="ti ti-users text-warning"></i></span>
                                    <span class="nav-link-title">Clientes & Leads</span>
                                </a>
                            </li>
                            <li class="nav-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "Agents" ? "active" : "")">
                                <a class="nav-link" asp-controller="Agents" asp-action="Index">
                                    <span class="nav-link-icon d-md-none d-lg-inline-block"><i class="ti ti-user-check text-purple"></i></span>
                                    <span class="nav-link-title">Vendedores</span>
                                </a>
                            </li>
                            <li class="nav-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "Contracts" ? "active" : "")">
                                <a class="nav-link" asp-controller="Contracts" asp-action="Index">
                                    <span class="nav-link-icon d-md-none d-lg-inline-block"><i class="ti ti-file-text text-danger"></i></span>
                                    <span class="nav-link-title">Contratos & Operaciones</span>
                                </a>
                            </li>
                        </ul>
                    </div>
                </div>
            </div>
        </header>

        <!-- Main Content Body -->
        <div class="page-wrapper mt-3">
            <div class="container-xl">
                @if (TempData["SuccessMessage"] != null)
                {
                    <div class="alert alert-success alert-dismissible fade show shadow-sm border-0" role="alert">
                        <div class="d-flex align-items-center">
                            <i class="ti ti-circle-check fs-2 me-2"></i>
                            <div>@TempData["SuccessMessage"]</div>
                        </div>
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                }

                @RenderBody()
            </div>

            <!-- Tabler Footer -->
            <footer class="footer footer-transparent d-print-none mt-5">
                <div class="container-xl">
                    <div class="row text-center align-items-center flex-row-reverse">
                        <div class="col-lg-auto ms-lg-auto">
                            <ul class="list-inline list-inline-dots mb-0">
                                <li class="list-inline-list-item"><a href="#" class="link-secondary">Soporte 24/7</a></li>
                                <li class="list-inline-list-item"><a href="#" class="link-secondary">Documentación</a></li>
                            </ul>
                        </div>
                        <div class="col-12 col-lg-auto mt-3 mt-lg-0">
                            <ul class="list-inline list-inline-dots mb-0">
                                <li class="list-inline-item">
                                    Copyright &copy; @DateTime.Now.Year
                                    <a href="#" class="link-secondary fw-bold">PropControl360</a>. Plataforma de Proyectos e Inmobiliarias.
                                </li>
                            </ul>
                        </div>
                    </div>
                </div>
            </footer>
        </div>
    </div>

    <!-- Tabler Core JS -->
    <script src="https://cdn.jsdelivr.net/npm/@@tabler/core@1.0.0-beta20/dist/js/tabler.min.js"></script>
    <!-- SweetAlert2 JS -->
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.all.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
