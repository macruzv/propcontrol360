@model propcontrol360.Models.Agent
@{
    ViewData["Title"] = "Registrar Vendedor";
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="card shadow-sm border-0">
            <div class="card-header bg-purple text-white">
                <h3 class="card-title fw-bold text-white mb-0">
                    <i class="ti ti-user-plus me-2"></i>Registrar Nuevo Vendedor / Asesor
                </h3>
            </div>
            <div class="card-body">
                <form asp-action="Create" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label fw-bold">Nombre Completo *</label>
                            <input asp-for="FullName" class="form-control" placeholder="Ej: Carlos Rosario" />
                            <span asp-validation-for="FullName" class="text-danger"></span>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label fw-bold">Correo Electrónico *</label>
                            <input asp-for="Email" class="form-control" placeholder="carlos@propcontrol360.com" />
                            <span asp-validation-for="Email" class="text-danger"></span>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label fw-bold">Teléfono / Celular</label>
                            <input asp-for="Phone" class="form-control" placeholder="+1 (809) 555-0000" />
                        </div>

                        <div class="col-md-6">
                            <label class="form-label fw-bold">Porcentaje de Comisión (%) *</label>
                            <div class="input-group">
                                <input asp-for="CommissionRate" class="form-control" type="number" step="0.1" value="5.0" />
                                <span class="input-group-text">%</span>
                            </div>
                        </div>

                        <div class="col-12">
                            <label class="form-label fw-bold">URL Foto de Perfil</label>
                            <input asp-for="AvatarUrl" class="form-control" placeholder="https://images.unsplash.com/..." />
                        </div>
                    </div>

                    <div class="d-flex justify-content-end gap-2 mt-4">
                        <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
                        <button type="submit" class="btn btn-purple text-white fw-bold">
                            <i class="ti ti-device-floppy me-1"></i> Guardar Vendedor
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
