@model propcontrol360.Models.Agent
@{
    ViewData["Title"] = "Editar Vendedor";
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="card shadow-sm border-0">
            <div class="card-header bg-purple text-white">
                <h3 class="card-title fw-bold text-white mb-0">
                    <i class="ti ti-edit me-2"></i>Editar Vendedor / Asesor Inmobiliario
                </h3>
            </div>
            <div class="card-body p-4">
                <form asp-action="Edit" method="post" id="agentForm">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                    <input type="hidden" asp-for="Id" />
                    <input type="hidden" asp-for="JoinedDate" />
                    <input type="hidden" asp-for="TotalSales" />

                    <!-- Live Photo & Name Preview Header -->
                    <div class="d-flex flex-column flex-sm-row align-items-center gap-3 p-3 bg-light rounded-3 mb-4 border">
                        <div class="position-relative">
                            <img id="avatarPreview" 
                                 src="@(string.IsNullOrWhiteSpace(Model.AvatarUrl) ? "https://images.unsplash.com/photo-1534528741775-53994a69daeb?auto=format&fit=crop&w=400&q=80" : Model.AvatarUrl)" 
                                 class="avatar avatar-2xl rounded-circle shadow border border-3 border-white" 
                                 style="width: 96px; height: 96px; object-fit: cover;"
                                 alt="Vista previa de perfil"
                                 onerror="this.src='https://images.unsplash.com/photo-1534528741775-53994a69daeb?auto=format&fit=crop&w=400&q=80';" />
                            <span class="badge bg-purple position-absolute bottom-0 end-0 p-1 rounded-circle border border-2 border-white" title="Foto activa">
                                <i class="ti ti-camera fs-5 text-white"></i>
                            </span>
                        </div>
                        <div class="flex-grow-1 text-center text-sm-start">
                            <h4 class="fw-bold mb-1 text-dark" id="namePreview">@(string.IsNullOrWhiteSpace(Model.FullName) ? "Nombre del Asesor" : Model.FullName)</h4>
                            <p class="text-muted small mb-0">Vista previa en tiempo real de la foto de perfil del asesor.</p>
                        </div>
                    </div>

                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label fw-bold">Nombre Completo *</label>
                            <input asp-for="FullName" id="fullNameInput" class="form-control" placeholder="Ej: Carlos Rosario" />
                            <span asp-validation-for="FullName" class="text-danger"></span>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label fw-bold">Correo Electrónico *</label>
                            <input asp-for="Email" class="form-control" placeholder="carlos@propcontrol360.com" />
                            <span asp-validation-for="Email" class="text-danger"></span>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label fw-bold">Teléfono / Celular</label>
                            <input asp-for="Phone" class="form-control" placeholder="+1 (809) 555-0000" />
                            <span asp-validation-for="Phone" class="text-danger"></span>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label fw-bold">Porcentaje de Comisión (%) *</label>
                            <div class="input-group">
                                <input asp-for="CommissionRate" class="form-control" type="number" step="0.1" />
                                <span class="input-group-text">%</span>
                            </div>
                            <span asp-validation-for="CommissionRate" class="text-danger"></span>
                        </div>

                        <div class="col-12">
                            <label class="form-label fw-bold">URL Foto de Perfil</label>
                            <div class="input-group">
                                <span class="input-group-text bg-white"><i class="ti ti-photo text-purple"></i></span>
                                <input asp-for="AvatarUrl" id="avatarUrlInput" class="form-control" placeholder="https://images.unsplash.com/..." />
                                <button type="button" class="btn btn-outline-secondary" id="btnResetAvatar" title="Restaurar avatar predeterminado">
                                    <i class="ti ti-refresh me-1"></i> Por Defecto
                                </button>
                            </div>
                            <div class="form-text text-muted small">Pega el enlace directo de la imagen para previsualizarla al instante arriba.</div>
                            <span asp-validation-for="AvatarUrl" class="text-danger"></span>
                        </div>

                        <div class="col-12">
                            <label class="form-check form-switch mt-2">
                                <input class="form-check-input" type="checkbox" asp-for="IsActive">
                                <span class="form-check-label fw-semibold">Asesor Activo en la Plataforma</span>
                            </label>
                        </div>
                    </div>

                    <div class="d-flex justify-content-end gap-2 mt-4">
                        <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
                        <button type="submit" class="btn btn-purple text-white fw-bold">
                            <i class="ti ti-device-floppy me-1"></i> Guardar Cambios
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const avatarInput = document.getElementById("avatarUrlInput");
            const avatarPreview = document.getElementById("avatarPreview");
            const nameInput = document.getElementById("fullNameInput");
            const namePreview = document.getElementById("namePreview");
            const btnReset = document.getElementById("btnResetAvatar");
            const defaultAvatar = "https://images.unsplash.com/photo-1534528741775-53994a69daeb?auto=format&fit=crop&w=400&q=80";

            function updateAvatar() {
                const url = avatarInput.value.trim();
                if (url) {
                    avatarPreview.src = url;
                } else {
                    avatarPreview.src = defaultAvatar;
                }
            }

            avatarInput.addEventListener("input", updateAvatar);
            avatarInput.addEventListener("paste", function() {
                setTimeout(updateAvatar, 50);
            });

            if (btnReset) {
                btnReset.addEventListener("click", function() {
                    avatarInput.value = defaultAvatar;
                    updateAvatar();
                });
            }

            if (nameInput && namePreview) {
                nameInput.addEventListener("input", function() {
                    namePreview.textContent = nameInput.value.trim() || "Nombre del Asesor";
                });
            }
        });
    </script>
}
