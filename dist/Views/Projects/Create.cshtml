@model propcontrol360.Models.Project
@{
    ViewData["Title"] = "Registrar Nuevo Proyecto";
}

<div class="row justify-content-center">
    <div class="col-lg-9">
        <div class="card shadow-sm border-0">
            <div class="card-header bg-primary text-white">
                <h3 class="card-title fw-bold text-white mb-0">
                    <i class="ti ti-building-community me-2"></i>Registrar Nuevo Proyecto / Desarrollo de Lotes
                </h3>
            </div>
            <div class="card-body p-4">
                <form asp-action="Create" method="post" enctype="multipart/form-data" id="projectForm">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <!-- Master Plan Image Preview Header -->
                    <div class="card bg-dark text-white mb-4 border-0 overflow-hidden shadow-sm">
                        <div class="row g-0 align-items-center">
                            <div class="col-md-5 text-center p-2">
                                <img id="planImagePreview" 
                                     src="/images/masterplan_clean.jpg" 
                                     class="img-fluid rounded border border-secondary" 
                                     style="max-height: 180px; width: 100%; object-fit: cover;" 
                                     alt="Vista previa del plano aéreo"
                                     onerror="this.onerror=null;this.src='/images/masterplan_clean.jpg';" />
                            </div>
                            <div class="col-md-7 p-4">
                                <span class="badge bg-success-lt mb-2">Plano Aéreo del Proyecto</span>
                                <h3 class="fw-bold mb-1 text-white" id="namePreviewTitle">Nuevo Desarrollo de Lotes</h3>
                                <p class="text-white-50 small mb-0">Esta imagen servirá como base para colocar y diseñar los lotes interactivos en el Master Plan.</p>
                            </div>
                        </div>
                    </div>

                    <div class="row g-3">
                        <div class="col-md-8">
                            <label class="form-label fw-bold">Nombre del Proyecto / Urbanización *</label>
                            <input asp-for="Name" id="projectNameInput" class="form-control form-control-lg fw-bold" placeholder="Ej: Residencial Costa Esmeralda" required />
                            <span asp-validation-for="Name" class="text-danger"></span>
                        </div>

                        <div class="col-md-4">
                            <label class="form-label fw-bold">Estado del Proyecto *</label>
                            <select asp-for="Status" asp-items="Html.GetEnumSelectList<propcontrol360.Models.ProjectStatus>()" class="form-select form-select-lg fw-bold"></select>
                        </div>

                        <div class="col-md-8">
                            <label class="form-label fw-bold">Ubicación / Dirección *</label>
                            <input asp-for="Location" class="form-control" placeholder="Ej: Carretera Principal Km 5, Playa Esmeralda" required />
                            <span asp-validation-for="Location" class="text-danger"></span>
                        </div>

                        <div class="col-md-4">
                            <label class="form-label fw-bold">Ciudad *</label>
                            <input asp-for="City" class="form-control" placeholder="Ej: Miches" required />
                            <span asp-validation-for="City" class="text-danger"></span>
                        </div>

                        <!-- Image File Upload / URL Selector -->
                        <div class="col-12">
                            <label class="form-label fw-bold">Imagen del Master Plan (Plano Aéreo / Mapa Base) *</label>
                            
                            <div class="card p-3 bg-light border rounded-3">
                                <div class="row g-3 align-items-center">
                                    <div class="col-md-6 border-end">
                                        <label class="form-label small fw-bold text-dark mb-1">
                                            <i class="ti ti-upload me-1 text-primary fs-3"></i> Subir Imagen desde tu Equipo
                                        </label>
                                        <input type="file" name="planImageFile" id="planImageFileInput" class="form-control form-control-lg bg-white" accept="image/*" onchange="previewSelectedFile(this)" />
                                        <div class="text-muted small mt-1">Selecciona el plano (.jpg, .png, .webp) guardado en tu PC.</div>
                                    </div>
                                    <div class="col-md-6">
                                        <label class="form-label small fw-bold text-dark mb-1">
                                            <i class="ti ti-link me-1 text-secondary fs-3"></i> O escribir URL / ruta de imagen
                                        </label>
                                        <div class="input-group">
                                            <input asp-for="MasterPlanImageUrl" id="planImageUrlInput" class="form-control form-control-lg bg-white" placeholder="/images/masterplan_clean.jpg" value="/images/masterplan_clean.jpg" />
                                            <button type="button" class="btn btn-outline-secondary" id="btnResetDefaultPlan" title="Restablecer plano por defecto">
                                                <i class="ti ti-refresh"></i>
                                            </button>
                                        </div>
                                        <div class="text-muted small mt-1">Ruta predeterminada en el servidor.</div>
                                    </div>
                                </div>
                            </div>
                            <span asp-validation-for="MasterPlanImageUrl" class="text-danger"></span>
                        </div>

                        <!-- Parámetros Financieros por Defecto -->
                        <div class="col-12">
                            <div class="card bg-light border-0 p-3 rounded-3 mt-2">
                                <h4 class="fw-bold text-dark mb-3"><i class="ti ti-coin text-success me-2"></i> Parámetros de Financiamiento Predeterminados para los Lotes</h4>
                                <div class="row g-3">
                                    <div class="col-md-4">
                                        <label class="form-label fw-bold">Precio Base por m² (USD)</label>
                                        <div class="input-group">
                                            <span class="input-group-text">$</span>
                                            <input asp-for="DefaultPricePerSqM" class="form-control fw-bold" type="number" step="0.01" value="250.00" />
                                            <span class="input-group-text">/m²</span>
                                        </div>
                                    </div>
                                    <div class="col-md-4">
                                        <label class="form-label fw-bold">% Enganche / Inicial Mínimo</label>
                                        <div class="input-group">
                                            <input asp-for="DefaultDownPaymentPercent" class="form-control fw-bold" type="number" step="0.1" value="10.0" />
                                            <span class="input-group-text">%</span>
                                        </div>
                                    </div>
                                    <div class="col-md-4">
                                        <label class="form-label fw-bold">Plazo Máximo a Financiar</label>
                                        <div class="input-group">
                                            <input asp-for="DefaultMaxFinancingMonths" class="form-control fw-bold" type="number" value="72" />
                                            <span class="input-group-text">meses</span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="col-12">
                            <label class="form-label fw-bold">Descripción General & Amenidades</label>
                            <textarea asp-for="Description" class="form-control" rows="3" placeholder="Detalles de amenidades (casa club, seguridad privada, piscina, áreas verdes, servicios de agua y luz)..."></textarea>
                        </div>
                    </div>

                    <div class="d-flex justify-content-end gap-2 mt-4">
                        <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
                        <button type="submit" class="btn btn-primary fw-bold">
                            <i class="ti ti-device-floppy me-1"></i> Guardar Proyecto
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        function previewSelectedFile(input) {
            if (input.files && input.files[0]) {
                const reader = new FileReader();
                reader.onload = function (e) {
                    document.getElementById("planImagePreview").src = e.target.result;
                };
                reader.readAsDataURL(input.files[0]);
            }
        }

        document.addEventListener("DOMContentLoaded", function () {
            const nameInput = document.getElementById("projectNameInput");
            const namePreview = document.getElementById("namePreviewTitle");
            const imgInput = document.getElementById("planImageUrlInput");
            const imgPreview = document.getElementById("planImagePreview");
            const btnReset = document.getElementById("btnResetDefaultPlan");
            const defaultImg = "/images/masterplan_clean.jpg";

            function updatePreview() {
                const url = imgInput.value.trim();
                imgPreview.src = url || defaultImg;
            }

            imgInput.addEventListener("input", updatePreview);
            imgInput.addEventListener("paste", () => setTimeout(updatePreview, 50));

            nameInput.addEventListener("input", function() {
                namePreview.textContent = nameInput.value.trim() || "Nuevo Desarrollo de Lotes";
            });

            btnReset.addEventListener("click", function() {
                imgInput.value = defaultImg;
                document.getElementById("planImageFileInput").value = "";
                updatePreview();
            });
        });
    </script>
}
