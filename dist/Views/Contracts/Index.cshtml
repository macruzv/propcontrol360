@model IEnumerable<propcontrol360.Models.Contract>
@{
    ViewData["Title"] = "Contratos & Ventas";
}

<div class="page-header d-print-none mb-4">
    <div class="row align-items-center">
        <div class="col">
            <h2 class="page-title fw-extrabold text-dark">
                <i class="ti ti-file-text text-danger me-2"></i>Contratos & Operaciones de Venta
            </h2>
        </div>
        <div class="col-auto ms-auto">
            <a asp-action="Create" class="btn btn-success fw-bold">
                <i class="ti ti-file-plus me-1"></i> Nueva Operación / Reserva
            </a>
        </div>
    </div>
</div>

<div class="card shadow-sm border-0">
    <div class="table-responsive">
        <table class="table table-vcenter card-table table-striped">
            <thead>
                <tr>
                    <th># Contrato</th>
                    <th>Inmueble / Lote</th>
                    <th>Cliente Comprador</th>
                    <th>Vendedor</th>
                    <th>Tipo</th>
                    <th>Monto Total</th>
                    <th>Inicial / Reserva</th>
                    <th>Comisión Vendedor</th>
                    <th>Fecha</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var contract in Model)
                {
                    <tr>
                        <td class="fw-bold">#CTR-@contract.Id.ToString("D4")</td>
                        <td>
                            <div class="fw-bold text-dark">@contract.Property?.Title</div>
                            <div class="text-muted small">@contract.Property?.Category | @contract.Property?.ProjectName</div>
                        </td>
                        <td>
                            <div class="fw-bold text-dark">@contract.Client?.FullName</div>
                            <div class="text-muted small">@contract.Client?.Phone</div>
                        </td>
                        <td>
                            <div class="fw-semibold">@contract.Agent?.FullName</div>
                        </td>
                        <td>
                            <span class="badge @(contract.ContractType == propcontrol360.Models.ContractType.Venta ? "bg-success" : "bg-warning")">
                                @contract.ContractType
                            </span>
                        </td>
                        <td class="fw-extrabold text-success fs-3">
                            $@contract.TotalAmount.ToString("N0") USD
                        </td>
                        <td class="fw-semibold text-primary">
                            $@contract.DownPayment.ToString("N0") USD
                        </td>
                        <td class="fw-semibold text-purple">
                            $@contract.CommissionAmount.ToString("N0") USD
                        </td>
                        <td class="text-muted small">
                            @contract.ContractDate.ToString("dd/MM/yyyy")
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
